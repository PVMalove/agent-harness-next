{
  "name": "harness-console-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p ../../../tests/web/tsconfig.json",
    "gen:protocol": "node scripts/gen-protocol.mjs",
    "test:e2e": "playwright test -c ../../../tests/web/playwright.config.ts",
    "test:e2e:update": "playwright test -c ../../../tests/web/playwright.config.ts --update-snapshots"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "happy-dom": "20.14.6",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
